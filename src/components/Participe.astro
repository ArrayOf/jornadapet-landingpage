---
import { Icon } from 'astro-icon/components';
import { PERFIS } from '../lib/validacao';
import { CHAVES_DE_ORIGEM } from '../lib/utm';
import { ACEITE_INICIO } from '../lib/formulario';
import { CONTATO_EMAIL, WHATSAPP_EMPRESA } from '../data/conteudo';
import { linkWhatsappEmpresa } from '../lib/indicacao';
import { mascararWhatsapp } from '../lib/whatsapp';
import { chaveDoSiteTurnstile } from '../lib/turnstile';

// Rota do nosso Worker (src/worker/convite.ts), que grava no Supabase.
const endpoint = '/api/convite';
const numeroEmpresa = linkWhatsappEmpresa(WHATSAPP_EMPRESA);
const chaveTurnstile = chaveDoSiteTurnstile(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY, import.meta.env.PUBLIC_INDEXAR === 'true');
const beneficios = [
  { icone: 'ph:chats-circle', titulo: 'Uma conversa sobre o seu dia a dia', texto: 'No horário que for melhor para você.' },
  { icone: 'ph:key', titulo: 'Convite para usar antes de todo mundo', texto: 'Sem custo enquanto estivermos testando.' },
  { icone: 'ph:compass', titulo: 'Você ajuda a decidir o que vem primeiro', texto: 'O que você pedir entra na nossa lista de prioridades.' },
];
---
<section id="participe" class="scroll-mt-20 relative overflow-hidden py-20 sm:py-28" x-intersect:enter="formVisivel = true" x-intersect:leave="formVisivel = false">
  <div class="blob b1 top-10 right-[10%] size-[420px]"></div>
  <div class="blob b2 bottom-0 right-[30%] size-[360px]"></div>
  <div class="blob b3 top-1/3 right-0 size-[300px]"></div>
  <div class="relative mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
    <div>
      <h2 class="max-w-[16ch] text-[clamp(2rem,4vw,3rem)] font-bold leading-[1.05]">Peça seu convite.</h2>
      <p class="mt-4 max-w-[44ch] text-[18px] leading-relaxed">O acesso é por convite. Deixe seu contato: a gente conversa sobre a sua rotina e, quando abrir a sua turma, envia o seu convite.</p>
      <ul class="mt-8 space-y-5">
        {beneficios.map((b) => (
          <li class="flex gap-4"><span class="grid size-10 shrink-0 place-items-center r-ctl border border-line bg-surface text-accent"><Icon name={b.icone} class="size-5" aria-hidden="true" /></span><div><div class="font-semibold text-ink">{b.titulo}</div><p class="text-[16px]">{b.texto}</p></div></li>
        ))}
      </ul>
    </div>

    <div class="glass r-card p-5 sm:p-8" x-data={`formulario(${JSON.stringify(endpoint)})`} @perfil.window="f.perfil = $event.detail">
      <div x-cloak x-show="status === 'ok'" class="flex min-h-[420px] flex-col items-start justify-center">
        <span class="grid size-14 place-items-center rounded-full bg-mint text-accent"><Icon name="ph:check-circle-fill" class="size-8" aria-hidden="true" /></span>
        <h3 x-ref="sucesso" tabindex="-1" class="mt-5 break-words text-[28px] font-bold focus:outline-none">Recebemos, <span x-text="primeiroNome"></span>!</h3>
        <p class="mt-2 max-w-[38ch] text-[16px] leading-relaxed">Vamos chamar você no WhatsApp <span class="font-semibold text-ink" x-text="whatsEnviado"></span> em até 3 dias úteis para conversar.</p>
        {numeroEmpresa && (
          <p class="mt-3 max-w-[38ch] text-[16px] leading-relaxed">Salve nosso número para reconhecer a mensagem: <a href={numeroEmpresa} class="font-semibold text-ink underline">{mascararWhatsapp(WHATSAPP_EMPRESA)}</a></p>
        )}
        <div class="mt-6 w-full r-card border border-line bg-surface p-5">
          <p class="font-semibold text-ink">Conhece mais alguém que adestra?</p>
          <p class="mt-1 text-[16px] leading-relaxed">Mande o link para pedir o convite também.</p>
          <p class="mt-2 text-[14px] leading-relaxed text-mute">Os convites saem aos poucos, em turmas. Se o seu colega também pedir, vocês entram na mesma turma.</p>
          <div class="mt-4 flex flex-col gap-2 sm:flex-row">
            <a :href="compartilhar" :target="matchMedia('(pointer: fine)').matches ? '_blank' : null" rel="noopener"
              class="cta r-ctl inline-flex min-h-11 w-full items-center justify-center gap-2 px-4 py-3 text-[16px] font-semibold sm:w-auto">
              <Icon name="ph:whatsapp-logo" class="size-5" aria-hidden="true" /> Enviar pelo WhatsApp<span class="sr-only"> (abre o WhatsApp)</span>
            </a>
            <button type="button" @click="copiar()" class="r-ctl inline-flex min-h-11 w-full items-center justify-center gap-2 border border-ink/25 bg-surface px-4 py-3 text-[16px] font-semibold text-ink hover:border-ink/50 sm:w-auto">
              <Icon name="ph:link" class="size-5" x-show="!copiado" aria-hidden="true" /><Icon name="ph:check" class="size-5 text-accent" x-cloak x-show="copiado" aria-hidden="true" /> Copiar link
            </button>
          </div>
          <div x-cloak x-show="mostrarLink" class="mt-3 space-y-1">
            <label for="f-link" class="block text-[14px] font-semibold text-ink">Seu link</label>
            <input id="f-link" x-ref="campoLink" type="text" readonly :value="linkCopia" aria-describedby="h-link" class="field r-ctl w-full px-3 py-2 text-[14px]" />
            <p id="h-link" class="text-[14px] text-mute">Não deu para copiar sozinho. Toque e segure o link para copiar.</p>
          </div>
        </div>
        <p class="sr-only" aria-live="polite" x-text="aviso"></p>
        <button type="button" class="mt-4 inline-flex min-h-11 items-center text-[14px] font-medium text-ink underline decoration-line decoration-2 hover:decoration-accent" @click="recomecar()">Errou algum dado? Enviar de novo</button>
      </div>

      <div class="aviso-sem-js min-h-[200px] flex-col items-start justify-center gap-3">
        <p class="text-[18px] font-semibold text-ink">Para pedir seu convite, ative o JavaScript no navegador.</p>
        <p class="text-[16px] leading-relaxed">Ou escreva para <span class="select-all font-medium text-ink">{CONTATO_EMAIL}</span> com seu nome, WhatsApp e cidade.</p>
      </div>
      <form method="post" action={endpoint} x-show="status !== 'ok'" :novalidate="true" @submit.prevent="enviarFormulario()" class="space-y-5">
        <input type="hidden" name="pagina" value="/" />
        {CHAVES_DE_ORIGEM.map((k) => <input type="hidden" name={k} :value={`origem.${k} ?? ''`} />)}

        <div class="space-y-2">
          <label for="f-nome" class="block text-[14px] font-semibold text-ink">Seu nome</label>
          <input id="f-nome" name="nome" required minlength="2" autocomplete="name" x-model="f.nome" @blur="tocar('nome')" :aria-invalid="(!!err.nome).toString()" aria-describedby="e-nome" class="field r-ctl w-full px-4 py-3 text-[16px]" />
          <p id="e-nome" aria-live="polite" class="text-[14px] text-danger" x-text="err.nome ?? ''"></p>
        </div>
        <div class="space-y-2">
          <label for="f-whats" class="block text-[14px] font-semibold text-ink">WhatsApp</label>
          <input id="f-whats" name="whatsapp" type="tel" required pattern="[\s\(\)\+\-]*(?:\d[\s\(\)\+\-]*){10,13}" inputmode="tel" autocomplete="tel-national" placeholder="(11) 98765-4321" x-model="f.whatsapp" @input="mascarar()" @blur="tocar('whatsapp')" :aria-invalid="(!!err.whatsapp).toString()" aria-describedby="h-whats e-whats" class="field r-ctl w-full px-4 py-3 text-[16px]" />
          <p id="h-whats" class="text-[14px] text-mute">Usamos só para falar com você sobre o teste.</p>
          <p id="e-whats" aria-live="polite" class="text-[14px] text-danger" x-text="err.whatsapp ?? ''"></p>
        </div>
        <fieldset class="space-y-2">
          <legend class="mb-2 block text-[14px] font-semibold text-ink">Você trabalha com</legend>
          <div class="flex flex-wrap gap-2">
            {PERFIS.map((p, i) => (
              <label class="chip-opt relative">
                <input type="radio" name="perfil" id={`f-perfil-${i}`} value={p} required={i === 0} x-model="f.perfil" @change="tocar('perfil')" aria-describedby="e-perfil" :aria-invalid="(!!err.perfil).toString()" />
                <span class="inline-flex min-h-11 cursor-pointer items-center rounded-full px-4 text-[14px] hover:border-ink/40">{p}</span>
              </label>
            ))}
          </div>
          <p id="e-perfil" aria-live="polite" class="text-[14px] text-danger" x-text="err.perfil ?? ''"></p>
        </fieldset>
        <div class="space-y-2">
          <label for="f-cidade" class="block text-[14px] font-semibold text-ink">Cidade e estado</label>
          <input id="f-cidade" name="cidade" required minlength="3" autocomplete="address-level2" placeholder="Campinas, SP" x-model="f.cidade" @blur="tocar('cidade')" :aria-invalid="(!!err.cidade).toString()" aria-describedby="e-cidade" class="field r-ctl w-full px-4 py-3 text-[16px]" />
          <p id="e-cidade" aria-live="polite" class="text-[14px] text-danger" x-text="err.cidade ?? ''"></p>
        </div>
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" x-model="isca" class="absolute -left-[9999px] size-px opacity-0" aria-hidden="true" />
        <div class="space-y-2">
          <label class="flex min-h-11 items-start gap-3 text-[14px] leading-snug">
            <input type="checkbox" id="f-aceite" name="aceite" value="sim" required x-model="f.aceite" @change="tocar('aceite')" :aria-invalid="(!!err.aceite).toString()" aria-describedby="e-aceite" class="mt-0.5 size-5 shrink-0 accent-[var(--accent)]" />
            <span>{ACEITE_INICIO} <a href="/privacidade" target="_blank" rel="noopener" class="font-medium text-ink underline">Política de privacidade<span class="sr-only"> (abre em nova aba)</span></a>.</span>
          </label>
          <p id="e-aceite" aria-live="polite" class="text-[14px] text-danger" x-text="err.aceite ?? ''"></p>
        </div>

        {/* Turnstile (anti-robô do Cloudflare): só aparece se precisar de uma interação. */}
        <div class="cf-turnstile" data-sitekey={chaveTurnstile} data-appearance="interaction-only" data-size="flexible" data-theme="auto" data-language="pt-br"></div>
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

        <div x-cloak x-show="status === 'erro'" role="alert" class="flex gap-3 r-ctl border border-danger/40 bg-danger/10 p-3 text-[14px] text-ink">
          <Icon name="ph:warning-circle" class="mt-0.5 size-5 shrink-0 text-danger" aria-hidden="true" />
          <span>Não conseguimos enviar agora. Seus dados continuam aqui: tente de novo em instantes ou escreva para <span class="select-all font-medium">{CONTATO_EMAIL}</span>.</span>
        </div>

        <button type="submit" :disabled="status === 'enviando'" class="cta r-ctl flex w-full items-center justify-center gap-2 px-5 py-4 text-[16px] font-semibold disabled:cursor-progress disabled:opacity-80">
          <span class="inline-flex items-center gap-2" x-show="status !== 'enviando'">Pedir meu convite <Icon name="ph:arrow-right" class="seta size-4" aria-hidden="true" /></span>
          <span class="inline-flex items-center gap-2" x-cloak x-show="status === 'enviando'"><Icon name="ph:circle-notch" class="size-4 animate-spin" aria-hidden="true" /> Enviando…</span>
        </button>
        <p class="text-center text-[14px] text-mute">A gente chama você no WhatsApp em até 3 dias úteis.</p>
      </form>
    </div>
  </div>
</section>

---
/** Símbolo da marca (NT-002): cabeça do mascote caramelo sobre sálvia. Cores fixas nos dois temas. */
import { Image } from 'astro:assets';
import cabeca from '../assets/marca/cabeca.png';
interface Props { tamanho?: 'sm' | 'md' | 'lg'; forma?: 'quadrado' | 'circulo' }
const { tamanho = 'md', forma = 'quadrado' } = Astro.props;
const px = { sm: 24, md: 32, lg: 40 }[tamanho];
---
<Image data-simbolo src={cabeca} width={px} height={px} densities={[1, 2, 3]} alt="" loading="eager"
  class:list={['shrink-0', forma === 'circulo' ? 'rounded-full' : 'r-ctl']} style={`width:${px}px;height:${px}px`} />

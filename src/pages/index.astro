---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Rodape from '../components/Rodape.astro';
import BarraCelular from '../components/BarraCelular.astro';
import Hero from '../components/Hero.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Previa from '../components/Previa.astro';
import ParaQuem from '../components/ParaQuem.astro';
import EmEstudo from '../components/EmEstudo.astro';
import Sobre from '../components/Sobre.astro';
import Participe from '../components/Participe.astro';
import Duvidas from '../components/Duvidas.astro';
import { organizacao, paginaDePerguntas, siteWeb } from '../lib/jsonld';
import { PERGUNTAS } from '../data/conteudo';
const site = Astro.site ?? new URL('https://jornadapet.com.br');
const jsonLd = [organizacao(site), siteWeb(site), paginaDePerguntas(PERGUNTAS)];
---
<Base title="JornadaPet: agenda e clientes para adestradores de cães" description="Organize tutores, pets, sessões e valores a receber do seu trabalho de adestramento no Telegram, sem instalar outro app. Acesso por convite." jsonLd={jsonLd}>
  <div x-data="pagina" :class="{ 'overflow-hidden': menu }">
    <BarraCelular />
    <Nav />
    <main id="conteudo">
      <Hero />
      <ComoFunciona />
      <Previa />
      <ParaQuem />
      <EmEstudo />
      <Sobre />
      <Participe />
      <Duvidas />
    </main>
    <Rodape />
  </div>
</Base>

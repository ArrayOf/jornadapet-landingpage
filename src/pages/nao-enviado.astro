---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Rodape from '../components/Rodape.astro';
import { CONTATO_EMAIL } from '../data/conteudo';
---
<Base title="Pedido não enviado: JornadaPet" description="Não conseguimos enviar seu pedido de convite para a JornadaPet." noindex>
  <div x-data="pagina">
    <Nav />
    <main id="conteudo" class="mx-auto max-w-2xl px-4 py-24 sm:px-6">
      <h1 class="text-[clamp(2rem,4vw,3rem)] font-bold leading-[1.05]">Não conseguimos enviar seu pedido</h1>
      <p class="mt-4 text-[18px] leading-relaxed">Pode ter sido uma instabilidade do nosso lado. Tente de novo em instantes ou escreva para <span class="select-all font-medium text-ink">{CONTATO_EMAIL}</span>.</p>
      <a href="/#participe" class="cta r-ctl mt-8 inline-flex items-center gap-2 px-5 py-3.5 text-[16px] font-semibold">Tentar de novo</a>
    </main>
    <Rodape />
  </div>
</Base>

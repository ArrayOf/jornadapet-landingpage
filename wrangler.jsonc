{
  // Cloudflare Workers com arquivos estáticos: o site é só o dist/ do Astro.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jornadapet-landingpage",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // /privacidade serve privacidade.html; endereço inexistente serve 404.html com status 404
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}

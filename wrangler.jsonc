{
  // Cloudflare Workers: arquivos estáticos do dist/ (Astro) + a rota /api/convite.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jornadapet",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Só /api/* passa pelo Worker; o resto é servido direto dos arquivos.
    "run_worker_first": ["/api/*"],
    // /privacidade serve privacidade.html; endereço inexistente serve 404.html com status 404
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // A URL não é sigilosa e fica aqui (variável só do painel some a cada deploy).
  // SUPABASE_SECRET_KEY é Secret no painel (Variables and Secrets) e nunca vem para o repositório.
  "vars": { "SUPABASE_URL": "https://stmjxrciznwdbemgoiyk.supabase.co" },
  "observability": { "enabled": true }
}

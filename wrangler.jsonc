{
  // Cloudflare Workers: arquivos estáticos do dist/ (Astro) + a rota /api/convite.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jornadapet",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Só /api/* passa pelo Worker; o resto é servido direto dos arquivos.
    "run_worker_first": ["/api/*"],
    // /privacidade serve privacidade.html; endereço inexistente serve 404.html com status 404
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // SUPABASE_URL e SUPABASE_SECRET_KEY ficam no painel (Variables and Secrets), não aqui.
  "observability": { "enabled": true }
}
